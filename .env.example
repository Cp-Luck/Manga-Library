# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real secrets, only this template.

# Free key from https://console.cloud.google.com — enable "Books API",
# then create an API key. Without this, ISBN lookups run unauthenticated
# and will hit Google's near-zero anonymous quota (429 errors).
GOOGLE_BOOKS_API_KEY=
